{
  "manifest_version": 3,
  "name": "Cookie Hub 一键获取 Cookie",
  "version": "1.4.0",
  "minimum_chrome_version": "116",
  "description": "在当前 Chrome 中获取已登录网站的 Cookie；迅雷云盘可分别获取 Cookie 和 Authorization。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["cookies", "tabs", "clipboardWrite", "downloads", "debugger", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Cookie Hub 一键获取 Cookie",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
